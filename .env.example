# Copy this file to .env on the VPS and fill in every value.
# docker-compose reads .env automatically. Do NOT commit the real .env.

# ---- Public URL / subpath ------------------------------------------------
# Path prefix when the app is not at the domain root (no trailing slash).
# Example: app at https://adminctl.companywebsite.com/dotenv → BASE_PATH=/dotenv
# Leave empty to serve at the domain root. Rebuild after changing (bake-time).
BASE_PATH=/dotenv
# Full public origin including BASE_PATH. Used by Auth.js for OAuth callbacks.
AUTH_URL=https://adminctl.companywebsite.com/dotenv
# Required behind a reverse proxy (Dokploy / Traefik / Caddy) on a non-Vercel host.
AUTH_TRUST_HOST=true

# ---- Postgres (bundled `db` service) -------------------------------------
# These initialize the Postgres container AND must match DATABASE_URL below.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=app
# Host is the compose service name `db`; no sslmode (traffic stays on the
# internal docker network). Keep user/password/db in sync with the vars above.
DATABASE_URL=postgresql://app:change-me-strong-password@db:5432/app

# ---- App secrets ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Only emails from this domain may sign in.
COMPANY_DOMAIN=example.com

# ---- Encryption key (KEK) ------------------------------------------------
# Path INSIDE the container. Create the host file first:
#   mkdir -p secrets && openssl rand -base64 32 > secrets/kek.b64
# docker-compose mounts ./secrets/kek.b64 read-only at this path.
KEK_FILE=/app/secrets/kek.b64
